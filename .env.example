# Required for durable production mode
DATABASE_URL=
AUTH_SECRET=
NEXT_PUBLIC_APP_URL=https://your-domain.example

# Optional OAuth/provider integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Optional authorized music provider
MUSIC_PROVIDER=
MUSIC_PROVIDER_CLIENT_ID=
MUSIC_PROVIDER_CLIENT_SECRET=

# Optional object storage
STORAGE_URL=

# Music Pro operational intelligence provider
AI_PROVIDER=wronai
AI_API_URL=
AI_API_KEY=
AI_MODEL=

# WronAI connection
# For an OpenAI-compatible WronAI gateway use its /v1/chat/completions endpoint.
# For WronAI/Ollama use the Ollama /api/chat endpoint.
WRONAI_API_URL=
WRONAI_API_KEY=
WRONAI_MODEL=
WRONAI_PROTOCOL=openai
