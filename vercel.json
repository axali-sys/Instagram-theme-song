{
  "version": 2,
  "cleanUrls": true,
  "headers": [
    {"source": "/(.*)", "headers": [{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"X-Frame-Options","value":"SAMEORIGIN"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},{"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=()"}] 
  ],
  "functions": {
    "api/**/*.js": {
      "runtime": "nodejs24.x"
    }
  },
  "rewrites": [
    { "source": "/api/auth/:route", "destination": "/api/auth?route=:route" },
    { "source": "/api/intelligence/build", "destination": "/api/intelligence?route=build" },
    { "source": "/api/notifications/preferences", "destination": "/api/notifications?route=preferences" },
    { "source": "/api/projects/:id/:action", "destination": "/api/project-actions?id=:id&action=:action" }
  ]
}
